{
  "entities": {
    "SaleItem": {
      "title": "SaleItem",
      "description": "Ítem o servicio incluido en una venta",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 200 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["id", "category", "description", "quantity", "unitPrice", "total"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Registro de venta facturada y estado de pago",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "clientName": { "type": "string", "maxLength": 150 },
        "clientPhone": { "type": "string", "maxLength": 50 },
        "clientEmail": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "amountPaid": { "type": "number" },
        "paymentStatus": { "type": "string", "maxLength": 20, "enum": ["Pagado", "Parcial", "Pendiente"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "lastPaymentDate": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "date", "clientName", "items", "subtotal", "discount", "total", "amountPaid", "paymentStatus", "paymentMethod"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Gasto operativo fijo, variable o extraordinario",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 30, "enum": ["Fijo", "Variable", "Extraordinario"] },
        "description": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "supplier": { "type": "string", "maxLength": 100 },
        "receiptNumber": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 20, "enum": ["Pagado", "Pendiente"] },
        "isRecurring": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "date", "category", "type", "description", "amount", "paymentMethod", "status"]
    },
    "ProductionCost": {
      "title": "ProductionCost",
      "description": "Costo directo de producción asociado a un trabajo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "orderReference": { "type": "string", "maxLength": 50 },
        "clientName": { "type": "string", "maxLength": 150 },
        "productName": { "type": "string", "maxLength": 100 },
        "quantityProduced": { "type": "number" },
        "materialName": { "type": "string", "maxLength": 100 },
        "materialQuantity": { "type": "number" },
        "materialUnitPrice": { "type": "number" },
        "materialTotalCost": { "type": "number" },
        "laborCost": { "type": "number" },
        "productionTime": { "type": "string", "maxLength": 50 },
        "otherCosts": { "type": "number" },
        "totalCost": { "type": "number" },
        "unitCost": { "type": "number" },
        "salePrice": { "type": "number" },
        "grossProfit": { "type": "number" },
        "profitMargin": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "date", "orderReference", "clientName", "productName", "quantityProduced", "materialName", "materialQuantity", "materialUnitPrice", "materialTotalCost", "laborCost", "productionTime", "otherCosts", "totalCost", "unitCost", "salePrice", "grossProfit", "profitMargin", "description"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedor de insumos y materiales",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name", "category"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Orden de compra a proveedor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "supplierId": { "type": "string", "maxLength": 50 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "itemsDescription": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "status": { "type": "string", "maxLength": 20, "enum": ["Pagado", "Pendiente"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "date", "supplierName", "itemsDescription", "amount", "status", "paymentMethod"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro inmutable de auditoría del sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 30, "enum": ["CREACIÓN", "MODIFICACIÓN", "ELIMINACIÓN"] },
        "module": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "timestamp", "action", "module", "description"]
    },
    "FixedExpenseConfig": {
      "title": "FixedExpenseConfig",
      "description": "Configuración individual de un gasto fijo recurrente",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "frequency": {
          "type": "string",
          "enum": ["Semanal", "Quincenal", "Mensual", "Bimestral", "Trimestral", "Semestral", "Anual"]
        },
        "dueDate": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name", "category", "amount", "frequency", "dueDate", "paymentMethod", "active"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Configuración general, financiera, metas, catálogos y gastos fijos del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "maxLength": 120 },
        "nit": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 160000 },
        "defaultTaxRate": { "type": "number" },
        "currencyCode": { "type": "string", "maxLength": 10 },
        "currencySymbol": { "type": "string", "maxLength": 10 },
        "monthlySalesGoal": { "type": "number" },
        "monthlyProfitGoal": { "type": "number" },
        "monthlyPurchasesBudget": { "type": "number" },
        "saleCategories": { "type": "array" },
        "expenseCategories": { "type": "object" },
        "paymentMethods": { "type": "array" },
        "fixedExpensesConfig": { "type": "array" }
      },
      "required": [
        "companyName",
        "nit",
        "address",
        "phone",
        "email",
        "defaultTaxRate",
        "currencyCode",
        "currencySymbol",
        "monthlySalesGoal",
        "monthlyProfitGoal",
        "monthlyPurchasesBudget",
        "saleCategories",
        "expenseCategories",
        "paymentMethods",
        "fixedExpensesConfig"
      ]
    },
    "MaterialTemplate": {
      "title": "MaterialTemplate",
      "description": "Material base del catálogo de costos de producción",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "unit": { "type": "string", "maxLength": 30 },
        "unitPrice": { "type": "number" }
      },
      "required": ["id", "name", "unit", "unitPrice"]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Lista blanca de usuarios autorizados para administrar el sistema",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "operator"] },
        "active": { "type": "boolean" }
      },
      "required": ["uid", "email", "role", "active"]
    }
  },
  "firestore": {
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Colección de ventas facturadas"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Colección de gastos operativos"
    },
    "/productionCosts/{pcId}": {
      "schema": { "$ref": "#/entities/ProductionCost" },
      "description": "Colección de costos directos de producción"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Colección de proveedores"
    },
    "/purchaseOrders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Colección de órdenes de compra"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Bitácora de auditoría"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Configuración comercial, financiera, metas y gastos fijos del negocio"
    },
    "/materialTemplates/{matId}": {
      "schema": { "$ref": "#/entities/MaterialTemplate" },
      "description": "Catálogo de materiales para costos de producción"
    },
    "/authorizedUsers/{uid}": {
      "schema": { "$ref": "#/entities/AuthorizedUser" },
      "description": "Control de acceso de usuarios autorizados del negocio"
    }
  }
}
