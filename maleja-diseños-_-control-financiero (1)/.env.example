# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/*).
# Configure in AI Studio Secrets or Render Environment Variables (never expose in client bundle).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server listen port (defaults to 3000 locally; Render sets PORT automatically).
PORT="3000"

# NODE_ENV: Set to "production" on Render to serve the built dist/ bundle.
NODE_ENV="development"

# ALLOWED_ADMIN_EMAILS: Comma-separated list of authorized owner/admin emails.
ALLOWED_ADMIN_EMAILS="malejacalcas@gmail.com"

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"
